<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- QA simulator only. Pass through Xcode to generate Simulated.xcent;
     never use for a physical device or pass directly to codesign. -->
<plist version="1.0"><dict>
  <key>application-identifier</key><string>app.siyue.mobile.accountqa</string>
  <key>get-task-allow</key><true/>
  <key>keychain-access-groups</key><array><string>app.siyue.mobile.accountqa</string></array>
</dict></plist>
