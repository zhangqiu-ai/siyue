# Server-side only. Never commit real secrets.
SIYUE_SERVER_PORT=8787
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Local deployment connection only; never load into mobile/desktop/API bundles.
# ALIYUN_HOST=
# ALIYUN_USERNAME=
# ALIYUN_PASSWORD=
# Separate API configuration: see apps/server/README.md.

# Apple native login remains disabled until real Apple configuration is available.
# Keep this JSON and its referenced PKCS8 .p8 key server-only, mode 600.
SIYUE_APPLE_ENABLED=false
# SIYUE_APPLE_CONFIG_FILE=/run/secrets/siyue-apple.json
# Comma-separated exact proxy CIDRs; empty means forwarded headers are not trusted.
SIYUE_TRUSTED_PROXY_CIDRS=
