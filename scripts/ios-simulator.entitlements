<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Simulator-only: pass through xcodebuild CODE_SIGN_ENTITLEMENTS.
     Never use for device signing or pass directly to codesign. -->
<plist version="1.0">
<dict>
  <key>application-identifier</key>
  <string>app.siyue.mobile</string>
  <key>get-task-allow</key>
  <true/>
  <key>keychain-access-groups</key>
  <array><string>app.siyue.mobile</string></array>
</dict>
</plist>
