# Siyue API and mail worker environment. This is a template: copy it OUTSIDE the release bundle
# (default /etc/siyue/siyue.env), fill in real values, keep mode 600.
# Never commit it, never put it inside the bundle, never load it into mobile or desktop builds.
#
# compose-level variables live in a separate /etc/siyue/compose.env:
#   SIYUE_VERSION, SIYUE_PG_NETWORK (qiuge-private), SIYUE_ENV_FILE, SIYUE_SECRETS_DIR,
#   SIYUE_API_BIND, SIYUE_NODE_IMAGE (default docker.m.daocloud.io/library/node:22-bookworm-slim,
#   which is already cached on the host)
#
# SIYUE_MIGRATION_DATABASE_URL must NOT appear here: the API refuses to start while holding
# migration credentials. Keep it in /etc/siyue/siyue-migrate.env for the migration step only.

SIYUE_ENVIRONMENT=production
SIYUE_SERVER_PORT=8787
SIYUE_POSTGRES_MAX_CONNECTIONS=5

# Existing PostgreSQL cluster (container qiuge-postgres on the qiuge-private docker network),
# Siyue database and Siyue runtime role only.
SIYUE_DATABASE_NAME=siyue
SIYUE_DATABASE_URL=postgresql://siyue_app:<siyue-app-password>@qiuge-postgres:5432/siyue

# Trusted proxy. nginx runs on the host and reaches the published port on 127.0.0.1:8787, so the
# container sees the docker bridge peer. Use the siyue-internal subnet:
#   docker network inspect siyue-internal --format '{{(index .IPAM.Config 0).Subnet}}'
# In practice listing '<siyue-internal-subnet>,127.0.0.1/32' is safe here: nginx is the host's own
# first entry point, so only the host itself could spoof the forwarded header. Never use 0.0.0.0/0,
# ::/0 or a whole private range, and keep nginx overwriting X-Forwarded-For.
SIYUE_TRUSTED_PROXY_CIDRS=<siyue-internal-subnet>,127.0.0.1/32

# Fixed for production (validated by auth-config.ts and by preflight.sh).
SIYUE_JWT_ISSUER=https://api.qiugeapp.com/api/siyue
SIYUE_JWT_AUDIENCE=siyue-api
SIYUE_JWT_KEY_ID=<kid-of-the-signing-key>

# Secret files, mounted read-only at /run/siyue-secrets. Mode 600, owner uid 1000 (node user).
SIYUE_JWT_PRIVATE_KEY_FILE=/run/siyue-secrets/jwt-private.pem
SIYUE_JWT_VERIFY_KEYS_FILE=/run/siyue-secrets/jwks.json
SIYUE_SECRET_ENCRYPTION_KEY_FILE=/run/siyue-secrets/encryption-keys.json
SIYUE_CHALLENGE_PEPPER_FILE=/run/siyue-secrets/challenge-pepper.txt

# Email: required for public registration and password reset this round.
# The file content is strict; for the Resend adapter it is exactly:
#   {"provider":"resend","apiKey":"<resend-api-key>","from":"<verified-sender>"}
# A file without "provider" keeps working as SMTP {"host","port","secure","user","password","from"}.
SIYUE_EMAIL_ENABLED=true
SIYUE_MAIL_CONFIG_FILE=/run/siyue-secrets/mail-config.json

# Sign-up policy. Without this file the API reports sign-up unavailable and only login stays open,
# so public registration needs it. Strict shape, at most 8192 bytes, https URLs, no credentials:
#   {"enabled":true,"terms":{"version":"2026-09-25",
#     "url":"https://api.qiugeapp.com/api/siyue/legal/terms.html"},
#    "privacy":{"version":"2026-09-25",
#     "url":"https://api.qiugeapp.com/api/siyue/legal/privacy.html"}}
# Those two documents ship in the release as legal/terms.html and legal/privacy.html and are served by
# nginx (see nginx/api.qiugeapp.com.siyue-location.conf). preflight.sh checks both the file and the URLs.
SIYUE_REGISTRATION_POLICY_FILE=/run/siyue-secrets/registration-policy.json

# Apple stays off until real Apple configuration exists; enabling it without config refuses startup.
SIYUE_APPLE_ENABLED=false

# Deletion ledger: account deletion needs all three. It is a separate database in the SAME cluster,
# so logical separation and per-database restore still hold, but there is no independent failure
# domain. Comment out all three only to deploy with DELETE /v1/me/account closed.
SIYUE_DELETION_LEDGER_DATABASE=siyue_deletion_ledger
SIYUE_DELETION_LEDGER_ENVIRONMENT=production
SIYUE_DELETION_LEDGER_URL=postgresql://siyue_deletion_ledger_app:<ledger-app-password>@qiuge-postgres:5432/siyue_deletion_ledger

# Keep disabled. Any value other than false refuses startup.
SIYUE_MOCK_AUTH_ENABLED=false
SIYUE_WECHAT_ENABLED=false
